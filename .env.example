# ==============================================================================
# Local Development Environment Configuration
# Copy this file to `.env` for local execution
# ==============================================================================

# Flask Settings
SECRET_KEY=local-dev-secret-key-2026
FLASK_DEBUG=true
PORT=5000

# Database Configuration (For Local MySQL or AWS RDS Testing)
